# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AI API Keys ---
GEMINI_API_KEYS=your-google-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEYS=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
DEEPSEEK_API_KEYS=your-deepseek-api-key-here

# --- Learning knowledge retrieval (RAG) ---
RAG_EMBEDDING_API_KEYS=your-google-gemini-api-key-here
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.45
