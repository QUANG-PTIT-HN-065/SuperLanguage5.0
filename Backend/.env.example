# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AI API Keys ---
GEMINI_API_KEYS=your-google-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEYS=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
DEEPSEEK_API_KEYS=your-deepseek-api-key-here

# --- Optional OpenAI-compatible Edge TTS service ---
# Set the base URL of a separately running openai-edge-tts service.
EDGE_TTS_BASE_URL=
EDGE_TTS_API_KEY=
GEMINI_CHAT_MODEL=""
ADSUP_TTS_BASE_URL=""
# Nhiều key ADSUP phân tách bằng dấu phẩy; key hết hạn mức sẽ tự chuyển key kế tiếp
ADSUP_API_KEYS=""

# --- Learning knowledge retrieval (RAG) ---
RAG_EMBEDDING_API_KEYS=your-google-gemini-api-key-here
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.45

# --- Cloudinary (upload ảnh đại diện JPG/PNG <= 10MB) ---
# Lấy tại https://console.cloudinary.com -> Dashboard (Cloud name, API Key, API Secret)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_AVATAR_FOLDER=slanguage/avatars
